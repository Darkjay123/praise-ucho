{
  "cleanUrls": true,
  "headers": [
    { "source": "/admin(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "no-store" } ] },
    { "source": "/content.default.json", "headers": [ { "key": "Cache-Control", "value": "public, max-age=60" } ] }
  ]
}
